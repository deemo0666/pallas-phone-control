+/// The first port of the dynamic range on this device that answers the RPPairing handshake. Used
+/// after a first pairing, when the device has just started its pairing service on a port of its own.
+pub async fn discover(near: SocketAddr) -> Option<SocketAddr> {
+    use std::sync::atomic::{AtomicU32, Ordering};
+    use std::sync::Arc;
+    let ip = near.ip();
+    let next = Arc::new(AtomicU32::new(49152));
+    let workers: Vec<_> = (0..128)
+        .map(|_| {
+            let next = next.clone();
+            tokio::spawn(async move {
+                let mut open = Vec::new();
+                loop {
+                    let port = next.fetch_add(1, Ordering::Relaxed);
+                    if port > 65535 {
+                        break;
+                    }
+                    // lockdown, never the pairing service
+                    if port == 62078 {
+                        continue;
+                    }
+                    let addr = SocketAddr::new(ip, port as u16);
+                    if let Ok(Ok(_)) = timeout(Duration::from_millis(700), TcpStream::connect(addr)).await {
+                        open.push(port as u16);
+                    }
+                }
+                open
+            })
+        })
+        .collect();
+    let mut open = Vec::new();
+    for worker in workers {
+        if let Ok(mut ports) = worker.await {
+            open.append(&mut ports);
+        }
+    }
+    open.sort_unstable();
+    ui::detail(&format!("open ports on {ip}: {open:?}"));
+    for port in open {
+        let addr = SocketAddr::new(ip, port);
+        if probe(addr).await.is_ok() {
+            return Some(addr);
+        }
+    }
+    None
+}
